# syntax=docker/dockerfile:1
# Installed-package E2E image for the GitHub Desktop Linux port (T11, T12).
# BASE_IMAGE selects the distro (ubuntu:24.04 default, debian:12).
# Stage `installed`: a CLEAN BASE_IMAGE with only the .deb installed via apt, so
# apt's dependency resolution is what the package alone provides.
# Stage `e2e`: adds xvfb/node and a non-root user on top; test tooling comes only after the install.
# Build context must contain the .deb:
#   script/linux/test/run-installed-e2e.sh does this for you.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE} AS installed
ENV DEBIAN_FRONTEND=noninteractive
COPY GitHubDesktop-linux-amd64-*.deb /tmp/
RUN apt-get update \
 && apt-get install -y ./tmp/GitHubDesktop-linux-amd64-*.deb 2>&1 | tee /var/log/gd-apt-install.log \
 && rm -rf /var/lib/apt/lists/* /tmp/*.deb
# The package's Depends alone must satisfy the shared libraries its binaries link against (ldd; not dlopen).
RUN missing=$(find /usr/lib/github-desktop -type f \( -perm -u+x -o -name '*.so*' -o -name '*.node' \) \
      -exec sh -c 'ldd "$1" 2>/dev/null | grep "not found" | sed "s|^|$1:|"' _ {} \;) \
 && if [ -n "$missing" ]; then echo "$missing"; echo "FAIL: unresolved shared libraries"; exit 1; fi \
 && echo "OK: no unresolved shared libraries under /usr/lib/github-desktop"

FROM installed AS e2e
ARG NODE_VERSION=24.15.0
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xauth curl ca-certificates xz-utils git \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz \
 && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
 && rm /tmp/node.tar.xz
RUN printf '#!/bin/sh\nexec node /work/vendor/yarn-1.21.1.js "$@"\n' > /usr/local/bin/yarn && chmod +x /usr/local/bin/yarn
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix
# ubuntu:24.04 ships an `ubuntu` user at uid 1000 (debian does not); replace it so file ownership matches the
# builder volumes (uid 1000) used by script/linux/run.sh.
RUN (getent passwd ubuntu >/dev/null && userdel -r ubuntu || true) && useradd -m -u 1000 -s /bin/bash tester
USER tester
ENV HOME=/home/tester
WORKDIR /work
CMD ["bash"]
